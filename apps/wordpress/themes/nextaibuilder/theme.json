{
	"$schema": "https://schemas.wp.org/wp/6.8/theme.json",
	"version": 3,
	"settings": {
		"appearanceTools": true,
		"useRootPaddingAwareAlignments": true,
		"layout": {
			"contentSize": "720px",
			"wideSize": "1200px"
		},
		"color": {
			"defaultPalette": false,
			"defaultGradients": false,
			"palette": [
				{
					"slug": "navy",
					"name": "Ink",
					"color": "#14213d"
				},
				{
					"slug": "navy-dark",
					"name": "Ink deep",
					"color": "#0b1735"
				},
				{
					"slug": "ink-2",
					"name": "Ink secondary",
					"color": "#33415c"
				},
				{
					"slug": "muted",
					"name": "Muted",
					"color": "#5f6b80"
				},
				{
					"slug": "primary",
					"name": "Brand blue",
					"color": "#2a6fa8"
				},
				{
					"slug": "primary-hover",
					"name": "Brand blue hover",
					"color": "#1f5a8c"
				},
				{
					"slug": "link",
					"name": "Link",
					"color": "#2a6fa8"
				},
				{
					"slug": "blue",
					"name": "Sky blue",
					"color": "#4a9ad4"
				},
				{
					"slug": "mint",
					"name": "Pale blue",
					"color": "#e8f2fb"
				},
				{
					"slug": "orange",
					"name": "Warm orange",
					"color": "#ff8c5a"
				},
				{
					"slug": "canvas",
					"name": "Canvas soft",
					"color": "#f6f9fc"
				},
				{
					"slug": "surface",
					"name": "White",
					"color": "#ffffff"
				},
				{
					"slug": "hairline",
					"name": "Hairline",
					"color": "#e3e8ee"
				},
				{
					"slug": "danger",
					"name": "Danger",
					"color": "#c0222e"
				},
				{
					"slug": "success",
					"name": "Success",
					"color": "#1f7a45"
				}
			],
			"gradients": [
				{
					"slug": "hero",
					"name": "Hero",
					"gradient": "linear-gradient(135deg, #4a9ad4 0%, #e8f4fd 55%, #6fb4dc 100%)"
				},
				{
					"slug": "cover-blue",
					"name": "Cover blue",
					"gradient": "linear-gradient(135deg, #4a9ad4 0%, #e8f4fd 100%)"
				},
				{
					"slug": "cover-navy",
					"name": "Cover navy",
					"gradient": "linear-gradient(135deg, #0d1a3a 0%, #3a4556 100%)"
				}
			]
		},
		"typography": {
			"fluid": true,
			"defaultFontSizes": false,
			"fontFamilies": [
				{
					"slug": "sans",
					"name": "Inter",
					"fontFamily": "Inter, ui-sans-serif, system-ui, -apple-system, 'Segoe UI', sans-serif",
					"fontFace": [
						{
							"fontFamily": "Inter",
							"fontStyle": "normal",
							"fontWeight": "100 900",
							"fontDisplay": "swap",
							"src": [
								"file:./assets/fonts/inter.woff2"
							]
						}
					]
				},
				{
					"slug": "mono",
					"name": "JetBrains Mono",
					"fontFamily": "'JetBrains Mono', ui-monospace, SFMono-Regular, Menlo, monospace",
					"fontFace": [
						{
							"fontFamily": "JetBrains Mono",
							"fontStyle": "normal",
							"fontWeight": "400 700",
							"fontDisplay": "swap",
							"src": [
								"file:./assets/fonts/jetbrains-mono.woff2"
							]
						}
					]
				}
			],
			"fontSizes": [
				{
					"slug": "xs",
					"name": "Caption",
					"size": "0.8125rem",
					"fluid": false
				},
				{
					"slug": "sm",
					"name": "Small",
					"size": "0.9375rem",
					"fluid": false
				},
				{
					"slug": "base",
					"name": "Body",
					"size": "1rem",
					"fluid": false
				},
				{
					"slug": "md",
					"name": "Lead",
					"size": "1.1875rem",
					"fluid": {
						"min": "1.0625rem",
						"max": "1.1875rem"
					}
				},
				{
					"slug": "lg",
					"name": "Heading",
					"size": "1.625rem",
					"fluid": {
						"min": "1.375rem",
						"max": "1.625rem"
					}
				},
				{
					"slug": "xl",
					"name": "Section",
					"size": "3rem",
					"fluid": {
						"min": "2rem",
						"max": "3rem"
					}
				},
				{
					"slug": "2xl",
					"name": "Display",
					"size": "3.5rem",
					"fluid": {
						"min": "2.375rem",
						"max": "3.5rem"
					}
				},
				{
					"slug": "hero",
					"name": "Hero",
					"size": "4.25rem",
					"fluid": {
						"min": "2.5rem",
						"max": "4.25rem"
					}
				}
			]
		},
		"spacing": {
			"defaultSpacingSizes": false,
			"units": [
				"px",
				"rem",
				"%",
				"vw",
				"vh"
			],
			"spacingSizes": [
				{
					"slug": "10",
					"name": "2XS",
					"size": "0.5rem"
				},
				{
					"slug": "20",
					"name": "XS",
					"size": "0.75rem"
				},
				{
					"slug": "30",
					"name": "S",
					"size": "1rem"
				},
				{
					"slug": "40",
					"name": "M",
					"size": "1.5rem"
				},
				{
					"slug": "50",
					"name": "L",
					"size": "clamp(1.75rem, 3vw, 2.5rem)"
				},
				{
					"slug": "60",
					"name": "XL",
					"size": "clamp(2.5rem, 5vw, 4rem)"
				},
				{
					"slug": "70",
					"name": "2XL",
					"size": "clamp(3rem, 7vw, 5.5rem)"
				}
			]
		},
		"shadow": {
			"defaultPresets": false,
			"presets": [
				{
					"slug": "ring",
					"name": "Lift",
					"shadow": "0 1px 3px rgba(0,55,112,0.08)"
				},
				{
					"slug": "card",
					"name": "Float",
					"shadow": "0 8px 24px rgba(0,55,112,0.08), 0 2px 6px rgba(0,55,112,0.04)"
				}
			]
		},
		"custom": {
			"radius": {
				"sm": "16px",
				"md": "20px",
				"lg": "30px",
				"xl": "40px",
				"pill": "9999px"
			},
			"ring": "rgba(26, 39, 68, 0.12)",
			"ring-strong": "rgba(26, 39, 68, 0.2)"
		}
	},
	"styles": {
		"color": {
			"background": "#ffffff",
			"text": "var(--wp--preset--color--navy)"
		},
		"typography": {
			"fontFamily": "var(--wp--preset--font-family--sans)",
			"fontSize": "var(--wp--preset--font-size--base)",
			"lineHeight": "1.6",
			"fontWeight": "400"
		},
		"spacing": {
			"blockGap": "1.25rem",
			"padding": {
				"left": "clamp(1rem, 5vw, 5rem)",
				"right": "clamp(1rem, 5vw, 5rem)"
			}
		},
		"elements": {
			"heading": {
				"color": {
					"text": "var(--wp--preset--color--navy)"
				},
				"typography": {
					"fontWeight": "300",
					"lineHeight": "1.08",
					"letterSpacing": "-0.025em"
				}
			},
			"h1": {
				"typography": {
					"fontSize": "var(--wp--preset--font-size--2xl)",
					"lineHeight": "1.04",
					"letterSpacing": "-0.03em"
				}
			},
			"h2": {
				"typography": {
					"fontSize": "var(--wp--preset--font-size--xl)",
					"lineHeight": "1.1",
					"letterSpacing": "-0.025em"
				}
			},
			"h3": {
				"typography": {
					"fontSize": "var(--wp--preset--font-size--lg)",
					"fontWeight": "400",
					"letterSpacing": "-0.012em",
					"lineHeight": "1.2"
				}
			},
			"h4": {
				"typography": {
					"fontSize": "var(--wp--preset--font-size--md)",
					"fontWeight": "500",
					"letterSpacing": "-0.01em"
				}
			},
			"link": {
				"color": {
					"text": "var(--wp--preset--color--link)"
				},
				"typography": {
					"textDecoration": "none"
				},
				":hover": {
					"color": {
						"text": "var(--wp--preset--color--primary-hover)"
					},
					"typography": {
						"textDecoration": "underline"
					}
				},
				":focus-visible": {
					"outline": {
						"color": "var(--wp--preset--color--primary)",
						"offset": "2px",
						"style": "solid",
						"width": "2px"
					}
				}
			},
			"button": {
				"color": {
					"background": "var(--wp--preset--color--primary)",
					"text": "#ffffff"
				},
				"border": {
					"radius": "9999px"
				},
				"spacing": {
					"padding": {
						"top": "0.7rem",
						"bottom": "0.7rem",
						"left": "1.35rem",
						"right": "1.35rem"
					}
				},
				"typography": {
					"fontWeight": "500",
					"fontSize": "1rem",
					"lineHeight": "1.25"
				},
				":hover": {
					"color": {
						"background": "var(--wp--preset--color--primary-hover)",
						"text": "#ffffff"
					}
				},
				":focus-visible": {
					"outline": {
						"color": "var(--wp--preset--color--primary)",
						"offset": "3px",
						"style": "solid",
						"width": "2px"
					}
				}
			}
		},
		"blocks": {
			"core/button": {
				"variations": {
					"outline": {
						"color": {
							"background": "#ffffff",
							"text": "var(--wp--preset--color--primary)"
						},
						"border": {
							"width": "1px",
							"style": "solid",
							"color": "var(--wp--preset--color--primary)"
						}
					}
				}
			},
			"core/details": {
				"border": {
					"bottom": {
						"color": "var(--wp--custom--ring)",
						"style": "solid",
						"width": "1px"
					}
				},
				"spacing": {
					"padding": {
						"top": "1.5rem",
						"bottom": "1.5rem"
					}
				}
			},
			"core/navigation": {
				"typography": {
					"fontSize": "var(--wp--preset--font-size--sm)",
					"fontWeight": "500"
				}
			},
			"core/post-title": {
				"typography": {
					"fontWeight": "300"
				}
			},
			"core/separator": {
				"color": {
					"text": "var(--wp--custom--ring)"
				}
			}
		}
	},
	"templateParts": [
		{
			"name": "header",
			"title": "Header",
			"area": "header"
		},
		{
			"name": "footer",
			"title": "Footer",
			"area": "footer"
		}
	],
	"customTemplates": [
		{
			"name": "page-wide",
			"title": "Full-width page (no title)",
			"postTypes": [
				"page"
			]
		}
	]
}