# URL the browser uses to reach the API.
# Dev: set to empty string — Next.js dev server proxies /api/* to localhost:4000.
# Prod: set to https://aleemhaider.com (nginx proxies /api/* to Fastify).
NEXT_PUBLIC_API_URL=

NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_GOOGLE_CLIENT_ID=
NEXT_PUBLIC_APPLE_CLIENT_ID=
NEXT_PUBLIC_APPLE_REDIRECT_URI=
NEXT_PUBLIC_SUPPORT_EMAIL=support@productbuilderacademy.com

# Set to "standalone" when building the Docker image for EC2 deployment.
# Leave unset when deploying to Vercel.
# OUTPUT=standalone

# sdk.nextaibuilder.com — Google Ads conversion tracking for the admission
# form. Both must be set (and the app rebuilt — these are inlined at build
# time) for conversions to actually fire; safely no-ops if either is blank.
# Get these from Google Ads: Tools & Settings > Conversions > New conversion
# action > Website > goal "Submit lead form" > pick this URL. Google
# generates the ID (format AW-XXXXXXXXX) and a separate label per action.
NEXT_PUBLIC_GOOGLE_ADS_ID=
NEXT_PUBLIC_GOOGLE_ADS_CONVERSION_LABEL=

# Paddle checkout (Paddle.js). Client-side token from the Paddle dashboard →
# Developer tools → Authentication. Sandbox tokens start with test_, live with live_.
NEXT_PUBLIC_PADDLE_ENV=sandbox
NEXT_PUBLIC_PADDLE_CLIENT_TOKEN=
