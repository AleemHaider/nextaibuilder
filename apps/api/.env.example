NODE_ENV=
PORT=4000
MONGODB_URI=
REDIS_URL=
JWT_SECRET=
JWT_REFRESH_SECRET=
ANTHROPIC_API_KEY=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=
S3_BUCKET_NAME=
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
APPLE_CLIENT_ID=
APPLE_TEAM_ID=
APPLE_KEY_ID=
APPLE_PRIVATE_KEY=
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
SLACK_BOT_TOKEN=
SLACK_WORKSPACE_ID=
SLACK_ERROR_WEBHOOK_URL=
FRONTEND_URL=
ML_WORKER_CONCURRENCY=3
GRACE_PERIOD_HOURS=72
CLAUDE_CONFIDENCE_THRESHOLD=80
# Observability (optional — leave blank to disable Sentry)
SENTRY_DSN=
SENTRY_RELEASE=
LOG_LEVEL=info
# Backups (see infra/BACKUP-RUNBOOK.md) — only needed on the EC2 host
# running the nab-backup.timer; safe to leave blank in dev.
BACKUP_BUCKET=
SLACK_BACKUP_WEBHOOK_URL=

# Free-enrollment coupon codes (comma-separated, case-insensitive).
# Leave blank to disable coupon-based free enrollment entirely.
FREE_ENROLL_COUPON_CODES=

# sdk.nextaibuilder.com — staff inbox notified on each physical-course
# admission form submission. Leave blank to disable the notification email
# (submissions are still stored and visible in /admin/admissions).
ADMISSIONS_NOTIFICATION_EMAIL=

# Paddle (second card-payment provider; sandbox for testing).
# Sandbox dashboard: https://sandbox-vendors.paddle.com  → Developer tools → Authentication
PADDLE_ENV=sandbox
PADDLE_API_KEY=
PADDLE_WEBHOOK_SECRET=

# Flash promo: X% off for N hours, per browser session (0 disables).
FLASH_PROMO_PERCENT=50
FLASH_PROMO_HOURS=2
