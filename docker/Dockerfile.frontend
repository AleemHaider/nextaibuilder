# ─────────────────────────────────────────────────────────────────────────────
# NAB Frontend — Production Dockerfile
# Multi-stage: build Next.js app (standalone) → minimal Node.js runtime image
# ─────────────────────────────────────────────────────────────────────────────

# Stage 1: install dependencies
FROM node:20-alpine AS deps
WORKDIR /build
COPY apps/web/package.json apps/web/package-lock.json ./
RUN npm ci --omit=dev=false

# Stage 2: build
FROM node:20-alpine AS builder
WORKDIR /build

COPY --from=deps /build/node_modules ./node_modules
COPY apps/web/ .

# Build args for NEXT_PUBLIC_* variables (baked into the client bundle at build time)
ARG NEXT_PUBLIC_API_URL
ARG NEXT_PUBLIC_APP_URL
ARG NEXT_PUBLIC_GOOGLE_CLIENT_ID
ARG NEXT_PUBLIC_APPLE_CLIENT_ID
ARG NEXT_PUBLIC_APPLE_REDIRECT_URI
ARG NEXT_PUBLIC_SUPPORT_EMAIL=support@productbuilderacademy.com

ENV NEXT_PUBLIC_API_URL=$NEXT_PUBLIC_API_URL
ENV NEXT_PUBLIC_APP_URL=$NEXT_PUBLIC_APP_URL
ENV NEXT_PUBLIC_GOOGLE_CLIENT_ID=$NEXT_PUBLIC_GOOGLE_CLIENT_ID
ENV NEXT_PUBLIC_APPLE_CLIENT_ID=$NEXT_PUBLIC_APPLE_CLIENT_ID
ENV NEXT_PUBLIC_APPLE_REDIRECT_URI=$NEXT_PUBLIC_APPLE_REDIRECT_URI
ENV NEXT_PUBLIC_SUPPORT_EMAIL=$NEXT_PUBLIC_SUPPORT_EMAIL

# Enable standalone output so only the minimum files needed to run are kept
ENV OUTPUT=standalone

RUN npm run build

# ─────────────────────────────────────────────────────────────────────────────
# Stage 3: minimal runtime
# ─────────────────────────────────────────────────────────────────────────────
FROM node:20-alpine AS runtime

ENV NODE_ENV=production
ENV PORT=3000
ENV HOSTNAME=0.0.0.0

WORKDIR /app

# next start only needs the standalone output + static assets
COPY --from=builder /build/.next/standalone ./
COPY --from=builder /build/.next/static ./.next/static
COPY --from=builder /build/public ./public

EXPOSE 3000

CMD ["node", "server.js"]
