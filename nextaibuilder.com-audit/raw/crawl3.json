       "@type": "FAQPage",
       "mainEntity": [
        {
         "@type": "Question",
         "name": "What is the difference between recorded and live cohorts?",
         "acceptedAnswer": {
          "@type": "Answer",
          "text": "Recorded courses are self-paced: watch the video lessons any time and rewatch as often as you like. Live cohorts run on a fixed schedule with real-time instructor sessions, Q&A and peer collaboration. Both follow the same curriculum."
         }
        },
        {
         "@type": "Question",
         "name": "Can I pay in installments?",
         "acceptedAnswer": {
          "@type": "Answer",
          "text": "Yes. Every course offers a 3-installment plan at no extra cost. The first payment is taken at checkout and the other two 30 and 60 days later."
         }
        },
        {
         "@type": "Question",
         "name": "Can I pay by bank transfer?",
         "acceptedAnswer": {
          "@type": "Answer",
          "text": "Yes. Choose bank transfer at checkout and upload your payment receipt. We confirm it and activate your enrollment, usually within one business day."
         }
        },
        {
         "@type": "Question",
         "name": "Do I get lifetime access to course materials?",
         "acceptedAnswer": {
          "@type": "Answer",
          "text": "Yes. Once enrolled you keep access to all course materials, including updates to the curriculum."
         }
        },
        {
         "@type": "Question",
         "name": "What if I miss a live session?",
         "acceptedAnswer": {
          "@type": "Answer",
          "text": "Every live session is recorded and posted to your student dashboard within 24 hours."
         }
        },
        {
         "@type": "Question",
         "name": "What tools do I need to get started?",
         "acceptedAnswer": {
          "@type": "Answer",
          "text": "A computer and an internet connection. The guided setup steps walk you through installing everything else, and our AI checks each step from a screenshot."
         }
        },
        {
         "@type": "Question",
         "name": "Is there a refund policy?",
         "acceptedAnswer": {
          "@type": "Answer",
          "text": "Yes. You get a full refund within 2 weeks of the cohort start date, no questions asked. See the refund policy page for details."
         }
        }
       ]
      },
