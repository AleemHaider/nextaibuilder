# nextaibuilder — Production Environment Variables Template
# FIR-87
#
# NEVER commit a populated version of this file.
# Copy to the server and fill in real values:
#   cp infra/.env.production.template /opt/nab/.env
#   chmod 600 /opt/nab/.env
#   nano /opt/nab/.env
#
# Generate secure secrets:
#   openssl rand -hex 32   (produces 64 hex chars — use for JWT secrets)

# ── Server ────────────────────────────────────────────────────────────────────
NODE_ENV=production
PORT=4000
HOST=0.0.0.0
LOG_LEVEL=info

# ── Frontend URL (for CORS allowlist) ─────────────────────────────────────────
FRONTEND_URL=https://nextaibuilder.com

# ── MongoDB Atlas ─────────────────────────────────────────────────────────────
# See infra/mongodb-atlas-setup.md for setup instructions
MONGODB_URI=mongodb+srv://nab-prod:PASSWORD@cluster0.xxxxx.mongodb.net/nextaibuilder?retryWrites=true&w=majority

# ── Redis (BullMQ workers) ────────────────────────────────────────────────────
# Self-hosted on EC2: redis://127.0.0.1:6379
# Managed (Redis Cloud / Upstash): rediss://username:password@host:port
REDIS_URL=redis://127.0.0.1:6379

# ── JWT ───────────────────────────────────────────────────────────────────────
# Generate: openssl rand -hex 32
JWT_SECRET=GENERATE_A_64_CHAR_HEX_SECRET
JWT_REFRESH_SECRET=GENERATE_A_DIFFERENT_64_CHAR_HEX_SECRET
COOKIE_SECRET=GENERATE_ANOTHER_64_CHAR_HEX_SECRET
REFRESH_TOKEN_COOKIE_DOMAIN=nextaibuilder.com

# ── Stripe ────────────────────────────────────────────────────────────────────
# See infra/stripe-setup.md for webhook registration instructions
STRIPE_SECRET_KEY=sk_live_...
STRIPE_WEBHOOK_SECRET=whsec_...

# ── Google OAuth ──────────────────────────────────────────────────────────────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ── Apple OAuth ───────────────────────────────────────────────────────────────
APPLE_CLIENT_ID=
APPLE_TEAM_ID=
APPLE_KEY_ID=
APPLE_PRIVATE_KEY=

# ── Email (SMTP) ──────────────────────────────────────────────────────────────
SMTP_HOST=smtp.youremailprovider.com
SMTP_PORT=587
SMTP_USER=noreply@nextaibuilder.com
SMTP_PASS=
EMAIL_FROM=nextaibuilder <noreply@nextaibuilder.com>

# ── Slack ─────────────────────────────────────────────────────────────────────
SLACK_BOT_TOKEN=xoxb-...
SLACK_WORKSPACE_ID=
SLACK_ERROR_WEBHOOK_URL=

# ── AWS S3 (receipt uploads) ──────────────────────────────────────────────────
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1
S3_BUCKET_NAME=nextaibuilder-receipts

# ── Anthropic (AI features) ───────────────────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-...
ML_CONFIDENCE_THRESHOLD=80
ML_WORKER_CONCURRENCY=3

# ── Admin / Platform settings ─────────────────────────────────────────────────
ADMIN_OTP_EXPIRY_MINUTES=10
GRACE_PERIOD_HOURS=72
SUPPORT_SCHEDULING_URL=https://calendly.com/your-link
