# ─────────────────────────────────────────────────────────────────────────────
# PBA Frontend — Environment Variables
# Copy this file to .env and fill in the values. Never commit .env.
# ─────────────────────────────────────────────────────────────────────────────

# ── API ───────────────────────────────────────────────────────────────────────
# Base URL of the Fastify API server (no trailing slash).
# Local development: http://localhost:4000
# Production: the public URL of your EC2 or load-balanced API.
VITE_API_URL=http://localhost:4000

# ── App public URL ────────────────────────────────────────────────────────────
# The public-facing URL of the frontend (no trailing slash).
# Used to build shareable certificate links (LinkedIn, Copy Link).
# Local development: set to your ngrok/tunnel URL to test sharing, e.g. https://abc123.ngrok.io
# Production: the real domain, e.g. https://app.productbuilderacademy.com
# If omitted, falls back to window.location.origin (correct in production, wrong for localhost).
VITE_APP_URL=

# ── Google OAuth ──────────────────────────────────────────────────────────────
# OAuth 2.0 Client ID from Google Cloud Console.
# Create one at: https://console.cloud.google.com/apis/credentials
# Under "Authorised JavaScript origins" add this app's origin (e.g. http://localhost:5173).
# Under "Authorised redirect URIs" add <origin>/auth/google/callback.
# Must match the GOOGLE_CLIENT_ID set in apps/api/.env.
VITE_GOOGLE_CLIENT_ID=

# ── Apple Sign-In ─────────────────────────────────────────────────────────────
# Services ID (client_id) registered in the Apple Developer portal.
# Create one at: https://developer.apple.com/account/resources/identifiers/list/serviceId
# Enable "Sign In with Apple" and add the return URL under the Services ID settings.
# Must match the APPLE_CLIENT_ID set in apps/api/.env.
VITE_APPLE_CLIENT_ID=

# Redirect URI registered with Apple for this app.
# Must exactly match one of the Return URLs configured in the Apple Developer portal
# under the Services ID > Sign In with Apple > Return URLs.
# If omitted the SDK defaults to <window.location.origin>/auth/apple/callback.
VITE_APPLE_REDIRECT_URI=http://localhost:5173/auth/apple/callback

# ── Support ───────────────────────────────────────────────────────────────────
# Email address displayed on the Help & Support page (/help) as the contact address.
# Shown in the "Email Support" card. Falls back to support@productbuilderacademy.com.
VITE_SUPPORT_EMAIL=support@productbuilderacademy.com

# DEPRECATED (PBA-334): The static scheduling URL card has been replaced by the
# /student/agents multi-agent booking system. This variable is no longer used.
# VITE_SUPPORT_SCHEDULING_URL=https://calendly.com/your-link
