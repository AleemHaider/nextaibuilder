# ─────────────────────────────────────────────────────────────────────────────
# NAB Frontend — Production Dockerfile
# Multi-stage: build Vite app → serve static files with nginx
# ─────────────────────────────────────────────────────────────────────────────

# Stage 1: build
FROM node:20-alpine AS builder

WORKDIR /build

# Copy manifests first (layer cache)
COPY nextaibuilder-app/package.json nextaibuilder-app/package-lock.json ./

RUN npm ci

# Copy source
COPY nextaibuilder-app/ .

# Build args for Vite environment variables (injected at build time)
ARG VITE_API_URL
ARG VITE_APP_URL
ARG VITE_GOOGLE_CLIENT_ID
ARG VITE_APPLE_CLIENT_ID
ARG VITE_APPLE_REDIRECT_URI
ARG VITE_SUPPORT_EMAIL=support@productbuilderacademy.com

ENV VITE_API_URL=$VITE_API_URL
ENV VITE_APP_URL=$VITE_APP_URL
ENV VITE_GOOGLE_CLIENT_ID=$VITE_GOOGLE_CLIENT_ID
ENV VITE_APPLE_CLIENT_ID=$VITE_APPLE_CLIENT_ID
ENV VITE_APPLE_REDIRECT_URI=$VITE_APPLE_REDIRECT_URI
ENV VITE_SUPPORT_EMAIL=$VITE_SUPPORT_EMAIL

RUN npm run build

# ─────────────────────────────────────────────────────────────────────────────
# Stage 2: serve
FROM nginx:alpine AS runtime

# Remove default nginx config
RUN rm /etc/nginx/conf.d/default.conf

# Copy our nginx config
COPY docker/nginx.conf /etc/nginx/conf.d/nab.conf

# Copy built static files
COPY --from=builder /build/dist /usr/share/nginx/html

EXPOSE 3000

CMD ["nginx", "-g", "daemon off;"]
